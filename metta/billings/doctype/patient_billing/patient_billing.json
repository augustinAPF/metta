{
  "doctype": "DocType",
  "name": "Patient Billing",
  "module": "Billings",
  "custom": 0,
  "autoname": "format:PB-.######",
  "document_type": "Document",
  "engine": "InnoDB",
  "is_single": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "show_dashboard": 0,
  "allow_import": 1,
  "allow_events_in_timeline": 1,
  "icon": "fa fa-file-invoice",
  "title_field": "patient",
  "search_fields": "patient,patient_name",
  "sort_field": "creation",
  "sort_order": "DESC",

  "fields": [
    {
      "fieldname": "patient_section",
      "fieldtype": "Section Break",
      "label": "Patient Information"
    },
    {
      "fieldname": "patient",
      "fieldtype": "Link",
      "label": "Patient (HIN)",
      "options": "Patient Details",
      "reqd": 1
    },
    {
      "fieldname": "patient_name",
      "fieldtype": "Data",
      "label": "Patient Name",
      "fetch_from": "patient.patient_name",
      "read_only": 1
    },

    {
      "fieldname": "medicine_section",
      "fieldtype": "Section Break",
      "label": "Medicines"
    },
    {
      "fieldname": "medicine_items",
      "fieldtype": "Table",
      "label": "Medicine Charges",
      "options": "Patient Billing Medicine"
    },

    {
      "fieldname": "service_section",
      "fieldtype": "Section Break",
      "label": "Services"
    },
    {
      "fieldname": "service_items",
      "fieldtype": "Table",
      "label": "Service Charges",
      "options": "Patient Billing Service"
    },

    {
      "fieldname": "totals_section",
      "fieldtype": "Section Break",
      "label": "Totals"
    },
    {
      "fieldname": "total_medicine_amount",
      "fieldtype": "Currency",
      "label": "Total Medicine Amount",
      "read_only": 1
    },
    {
      "fieldname": "total_service_amount",
      "fieldtype": "Currency",
      "label": "Total Service Amount",
      "read_only": 1
    },
    {
      "fieldname": "grand_total",
      "fieldtype": "Currency",
      "label": "Grand Total",
      "read_only": 1
    }
  ],

  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "print": 1,
      "report": 1
    }
  ]
}
